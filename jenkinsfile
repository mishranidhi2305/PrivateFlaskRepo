pipeline {
    agent any 
        environment {
            IMAGE="docker.io/mishranidhi/nidhi-flaskpipeline"
            TAG="${BUILD_NUMBER}"
        }
        stages {
            stage ('Code') {
                steps {
                    echo 'Cloning repo'
                    git branch: 'main', changelog: false, credentialsId: 'nidhi-github', poll: false, url: 'https://github.com/mishranidhi2305/PrivateFlaskRepo.git'
                }
            }
            stage ('Build') {
                steps {
                 sh 'docker build -t "$IMAGE:$TAG" -t "$IMAGE:latest" .'
                }
            }
            stage ('push') {
                steps {
                    withCredentials([usernamePassword(credentialsId: 'dockerhub', passwordVariable: 'DOCKER_PASS', usernameVariable: 'DOCKER_USER')]) {
                        sh 'docker push "$IMAGE:$TAG"'
                        sh 'docker push "$IMAGE:latest"'
                        }
                }
            }
            
           stage('Deploy') {
    steps {

        sh 'docker pull $IMAGE:$TAG'

        sh '''
            docker stop flaskapp || true
            docker rm -f flaskapp || true
            sleep 5
        '''

        sh '''
            docker run -d \
            -p 5000:5000 \
            --name flaskapp \
            $IMAGE:$TAG
        '''
    }
}
            stage ('test'){
                steps {
                     sh 'sleep 2; echo "Hit http://localhost:5000 to see the app."'
                }
            }
            stage ('cleanup') {
                steps {
                    cleanWs()
                }
            }
            
        }
}
